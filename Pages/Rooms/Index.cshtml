@page
@model Kolumban_Brigitta_Proiect.Pages.Rooms.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Rooms</h1>
<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-3">
            <select asp-for="HotelId"
                    asp-items="Model.Hotels"
                    class="form-control">
                <option value="">-- All Hotels --</option>
            </select>
        </div>

        <div class="col-md-3">
            <input type="date"
                   asp-for="FromDate"
                   class="form-control"
                   placeholder="Check-in" />
        </div>

        <div class="col-md-3">
            <input type="date"
                   asp-for="ToDate"
                   class="form-control"
                   placeholder="Check-out" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </div>
</form>


<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Hotel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].RoomNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Capacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].PricePerNight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Availability)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Room) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Hotel.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RoomNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Capacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PricePerNight)
            </td>
             <td>
                    @{
                        var today = DateTime.Today;
                        var isBookedToday = item.Reservations != null && item.Reservations.Any(r =>
                        r.CheckInDate.Date <= today &&
                        r.CheckOutDate.Date > today
                        );
                    }

                    @if (!item.Availability)
                    {
                        <span class="badge bg-danger">Unavailable</span>
                    }
                    else if (isBookedToday)
                    {
                        <span class="badge bg-warning text-dark">Booked today</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Available</span>
                    }
             </td>

            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
